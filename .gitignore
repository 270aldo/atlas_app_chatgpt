# ============================================
# ATLAS App ChatGPT - .gitignore
# ============================================

# ============================================
# Node.js
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
.turbo/
.vite/
.vercel/

# Testing
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
.env.local
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.tox/
*.egg-info/
dist/
build/

# ============================================
# Environment & Secrets
# ============================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cert
*.der
secrets/
credentials/
.secrets

# ============================================
# IDEs & Editors
# ============================================
# VSCode
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (IntelliJ, WebStorm, PyCharm)
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

# ============================================
# macOS
# ============================================
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# ============================================
# Windows
# ============================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================
# Linux
# ============================================
*~
.directory
.Trash-*

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# Temporary Files
# ============================================
tmp/
temp/
*.tmp
*.bak
*.swp

# ============================================
# Assets Compilados (Widgets)
# ============================================
assets/*.js
assets/*.css
assets/*.html
!assets/.gitkeep

# ============================================
# Database
# ============================================
*.db
*.sqlite
*.sqlite3

# ============================================
# Misc
# ============================================
.turbo
.eslintcache
tsconfig.tsbuildinfo
