{
  "version": 2,
  "public": false,
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Access-Control-Allow-Origin": "*"
      },
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "headers": { "Access-Control-Allow-Origin": "*" },
      "dest": "/$1"
    }
  ]
}
